        {
          "name": "[BUG] Fechado sem correção",
          "desc": "# Motivo\n- Duplicado, inválido, fora de escopo ou não reproduzível.\n\n# Referência\n- Link para card relacionado ou decisão.",
          "idLabels": [
            "lab_bug",
            "lab_priority_low"
          ]
        }
      ]
    },
    {
      "name": "⛔ Blocked",
      "cards": [
        {
          "name": "[BLOCKED] Bug bloqueado",
          "desc": "# Motivo\nDescrever dependência que impede correção ou validação.\n\n# Próxima Ação\n- [ ] Responsável definido\n- [ ] Evidência necessária listada",
          "idLabels": [
            "lab_blocked",
            "lab_bug"
          ],
          "customFieldItems": [
            {
              "value": null,
