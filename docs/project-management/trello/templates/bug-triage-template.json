  "lists": [
    {
      "name": "🐞 Reported",
      "cards": [
        {
          "name": "[BUG] Descrever comportamento incorreto",
          "desc": "# Resumo\nDescrever o problema observado.\n\n# Passos para Reproduzir\n1. Passo 1\n2. Passo 2\n3. Passo 3\n\n# Resultado Atual\nO que aconteceu.\n\n# Resultado Esperado\nO que deveria acontecer.\n\n# Evidências\n- Screenshot, vídeo, log ou link",
          "idLabels": [
            "lab_bug",
            "lab_priority_medium"
          ],
          "customFieldItems": [
            {
              "value": null,
              "idValue": "opt_reported",
              "idCustomField": "cf_status"
            },
            {
              "value": null,
              "idValue": "opt_sev_medium",
              "idCustomField": "cf_severity"
            },
            {
              "value": null,
              "idValue": "opt_env_dev",
              "idCustomField": "cf_environment"
            }
          ]
        }
      ]
    },
    {
      "name": "🔎 Triage",
      "cards": [
        {
          "name": "[TRIAGE] Classificar bug",
          "desc": "# Checklist\n- [ ] Severidade definida\n- [ ] Ambiente confirmado\n- [ ] Área afetada marcada\n- [ ] Regressão avaliada\n- [ ] Responsável definido",
          "checklists": [
            {
              "name": "Checklist",
              "checkItems": [
                {
                  "name": "Severidade definida",
                  "pos": 1,
                  "state": "incomplete"
                },
                {
                  "name": "Ambiente confirmado",
                  "pos": 2,
                  "state": "incomplete"
                },
                {
                  "name": "Área afetada marcada",
                  "pos": 3,
                  "state": "incomplete"
                },
                {
                  "name": "Regressão avaliada",
                  "pos": 4,
                  "state": "incomplete"
                },
                {
                  "name": "Responsável definido",
                  "pos": 5,
                  "state": "incomplete"
                }
              ]
            }
          ],
          "idLabels": [
            "lab_bug",
            "lab_qa"
          ]
        }
      ]
    },
    {
      "name": "✅ Reproduced",
      "cards": [
        {
          "name": "[BUG] Bug reproduzido",
          "desc": "# Evidência de Reprodução\n- [ ] Passos confirmados\n- [ ] Log relevante anexado\n- [ ] Versão/build informada\n\n# Hipótese Técnica\nDescrever possível causa.",
          "idLabels": [
            "lab_bug",
            "lab_fix"
          ],
          "customFieldItems": [
            {
              "value": null,
              "idValue": "opt_reproduced",
              "idCustomField": "cf_status"
            }
          ]
        }
      ]
    },
    {
      "name": "🚧 Fixing",
      "cards": [
        {
          "name": "[FIX] Corrigir bug confirmado",
          "desc": "# Objetivo\nCorrigir causa raiz do bug.\n\n# Critérios de Aceite\n- [ ] Bug não reproduz mais\n- [ ] Fluxo relacionado continua funcionando\n- [ ] Regressão avaliada\n\n# Guardrails de UI\n- [ ] Localization Guard aplicado quando houver copy de UI\n- [ ] Theme Guard aplicado para evitar hardcodeds visuais",
          "checklists": [
            {
              "name": "Acceptance Criteria",
              "checkItems": [
                {
                  "name": "Bug não reproduz mais",
                  "pos": 1,
                  "state": "incomplete"
                },
                {
                  "name": "Fluxo relacionado continua funcionando",
                  "pos": 2,
                  "state": "incomplete"
                },
                {
                  "name": "Regressão avaliada",
                  "pos": 3,
                  "state": "incomplete"
                }
              ]
            },
            {
              "name": "Localization Guard Checklist",
              "checkItems": [
                {
                  "name": "Every new user-facing string has an ARB key",
                  "pos": 1,
                  "state": "incomplete"
                },
                {
                  "name": "UI reads strings through AppLocalizations",
                  "pos": 2,
                  "state": "incomplete"
                },
                {
                  "name": "No hardcoded copy in UI widgets and placeholders",
                  "pos": 3,
                  "state": "incomplete"
                }
              ]
            },
            {
              "name": "Theme Guard Checklist",
              "checkItems": [
                {
                  "name": "UI uses semantic theme APIs and app tokens",
                  "pos": 1,
                  "state": "incomplete"
                },
                {
                  "name": "No Color(0x...) hardcoded values in presentation",
                  "pos": 2,
                  "state": "incomplete"
                },
                {
                  "name": "No AppLightColors/AppDarkColors usage outside lib/app/theme",
                  "pos": 3,
                  "state": "incomplete"
                },
                {
                  "name": "No Colors.* hardcoded usage in feature presentation when semantic ColorScheme roles exist",
                  "pos": 4,
                  "state": "incomplete"
                }
              ]
            }
          ],
          "idLabels": [
            "lab_fix",
            "lab_priority_high"
          ],
          "customFieldItems": [
            {
              "value": null,
              "idValue": "opt_fixing",
              "idCustomField": "cf_status"
            }
          ]
        }
      ]
    },
    {
      "name": "👀 Review",
      "cards": []
    },
    {
      "name": "🧪 QA Validation",
      "cards": [
        {
          "name": "[QA] Validar correção",
          "desc": "# Validação\n- [ ] Cenário original validado\n- [ ] Cenários próximos testados\n- [ ] Evidência anexada\n- [ ] Ambiente registrado",
          "idLabels": [
            "lab_qa",
            "lab_fix"
          ],
          "customFieldItems": [
            {
              "value": null,
              "idValue": "opt_validated",
              "idCustomField": "cf_status"
