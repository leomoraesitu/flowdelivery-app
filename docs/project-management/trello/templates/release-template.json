    {
      "name": "📦 Release Scope",
      "cards": [
        {
          "name": "[RELEASE] vX.Y.Z — Nome da Release",
          "desc": "# Objetivo\nDefinir o objetivo da release.\n\n# Escopo\n- Feature 1\n- Correção 1\n- Ajuste técnico 1\n\n# Fora de Escopo\n- Item que não entra nesta release\n\n# Critérios de Aceite\n- [ ] Escopo fechado\n- [ ] Dependências mapeadas\n- [ ] Riscos documentados\n\n# Guardrails de UI\n- [ ] Localization Guard aplicado para mudanças de copy\n- [ ] Theme Guard aplicado para mudanças visuais",
          "checklists": [
            {
              "name": "Scope",
              "checkItems": [
                {
                  "name": "Feature 1",
                  "pos": 1,
                  "state": "incomplete"
                },
                {
                  "name": "Correção 1",
                  "pos": 2,
                  "state": "incomplete"
                },
                {
                  "name": "Ajuste técnico 1",
                  "pos": 3,
                  "state": "incomplete"
                }
              ]
            },
            {
              "name": "Acceptance Criteria",
              "checkItems": [
                {
                  "name": "Escopo fechado",
                  "pos": 1,
                  "state": "incomplete"
                },
                {
                  "name": "Dependências mapeadas",
                  "pos": 2,
                  "state": "incomplete"
                },
                {
                  "name": "Riscos documentados",
                  "pos": 3,
                  "state": "incomplete"
                }
              ]
            },
            {
              "name": "Localization Guard Checklist",
              "checkItems": [
                {
                  "name": "Every new user-facing string has an ARB key",
                  "pos": 1,
                  "state": "incomplete"
                },
                {
                  "name": "UI reads strings through `AppLocalizations`",
                  "pos": 2,
                  "state": "incomplete"
                },
                {
                  "name": "No hardcoded copy in `Text`, `SnackBar`, `Tooltip`, `AlertDialog`, `BottomSheet`, `showModalBottomSheet`, or `semanticLabel`",
                  "pos": 3,
                  "state": "incomplete"
                },
                {
                  "name": "New placeholders and route placeholders are covered by the guard test",
                  "pos": 4,
                  "state": "incomplete"
                }
              ]
            },
            {
              "name": "Theme Guard Checklist",
              "checkItems": [
                {
                  "name": "UI uses only semantic theme APIs and app tokens (`Theme.of(context)`, `AppSpacing`, `AppRadius`, `AppSizes`, `AppDurations`)",
                  "pos": 1,
                  "state": "incomplete"
                },
                {
                  "name": "No `Color(0x...)` hardcoded values in feature presentation code",
                  "pos": 2,
                  "state": "incomplete"
                },
                {
                  "name": "No direct `AppLightColors` or `AppDarkColors` usage outside `lib/app/theme`",
                  "pos": 3,
                  "state": "incomplete"
                },
                {
                  "name": "No direct `Colors.*` hardcoded usage in feature presentation when equivalent semantic `ColorScheme` roles exist",
                  "pos": 4,
                  "state": "incomplete"
                },
                {
                  "name": "Visual hardcoded guard test remains green after UI changes",
                  "pos": 5,
                  "state": "incomplete"
                }
              ]
            }
          ],
          "idLabels": [
            "lab_release",
            "lab_priority_high"
