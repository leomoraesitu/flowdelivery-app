{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Dart: Current File",
            "type": "dart",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}"
        },
        {
            "name": "flowdelivery_app",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "flowdelivery_app (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "flowdelivery_app (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "flowdelivery_app (supabase)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=.vscode/supabase.local.json"
            ]
        },
        {
            "name": "flowdelivery_app (supabase web)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "toolArgs": [
                "--dart-define-from-file=.vscode/supabase.local.json"
            ]
        }
    ]
}
